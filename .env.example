# Voice Agent platform configuration.
# Copy to .env and fill in. With everything empty, the bot runs in MOCK_MODE
# and needs no provider keys at all.

# --- Server ---
VA_HOST=0.0.0.0
VA_PORT=8080
# Pipeline sample rate. 8000 = telephony (Exotel/Telnyx). 16000 only for web/WebRTC.
VA_SAMPLE_RATE=8000

# --- Bot mode ---
# echo  = bidirectional audio loop test (M1 gate), no STT/LLM/TTS
# agent = full STT -> LLM -> TTS pipeline
VA_MODE=agent

# --- Mock mode ---
# true  = scripted MockSTT/MockLLM/MockTTS; runs with zero API keys
# false = real providers below (requires keys)
VA_MOCK_MODE=true

# --- Carrier: exotel | telnyx ---
VA_CARRIER=exotel

# --- STT (Deepgram) ---
DEEPGRAM_API_KEY=
VA_STT_MODEL=nova-3
# "multi" enables Hindi/English code-switching on nova-3 (passed through to Deepgram)
VA_STT_LANGUAGE=multi

# --- LLM (Google Gemini) ---
GOOGLE_API_KEY=
VA_LLM_MODEL=gemini-2.5-flash
VA_LLM_TEMPERATURE=0.6

# --- TTS (Cartesia) ---
CARTESIA_API_KEY=
VA_TTS_MODEL=
# Hindi-capable voice id from the Cartesia voices gallery (verify quality on real scripts)
VA_TTS_VOICE_ID=

# --- Turn taking ---
VA_VAD_STOP_SECS=0.2
# Minimum words a user utterance must contain to start/interrupt a turn (ignores coughs/noise)
VA_MIN_START_WORDS=2

# --- Tool engine ---
# Push a filler phrase if a tool takes longer than this
VA_FILLER_AFTER_MS=400
VA_TOOL_TIMEOUT_SECS=10
# Simulated latency for built-in mock tools (ms) - set > FILLER_AFTER_MS to demo the filler
VA_MOCK_TOOL_DELAY_MS=900
# HMAC secret used to sign outgoing tool HTTP requests (dev only; use a vault in prod)
VA_TOOL_HMAC_SECRET=dev-secret

# --- Circuit breakers ---
VA_SILENCE_TIMEOUT_SECS=45
VA_MAX_CALL_DURATION_SECS=900

# --- Data ---
VA_TENANTS_DIR=config/tenants
VA_DATA_DIR=data

# --- Exotel account management (status check, future hangup/transfer APIs) ---
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_BASE=https://api.exotel.com
